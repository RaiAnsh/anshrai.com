# Stripe (required for /pay and /admin)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin auth (required for /admin)
# ADMIN_PASSWORD_HASH — bcrypt hash of your admin password. Generate with:
#   node -e "const b=require('bcryptjs');b.hash('your-password',12).then(console.log)"
ADMIN_PASSWORD_HASH=
ADMIN_COOKIE_SECRET=generate-32-plus-random-chars-here

# Job Matcher (required for /jobs)
JOBS_ACCESS_CODE=change-me
JOBS_COOKIE_SECRET=generate-32-plus-random-chars-here

# Adzuna — optional, broader job coverage. Free key at developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
